rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shop pictures are intentionally public product assets. All writes and
    // deletes go through authenticated, admin-checked Cloud Functions.
    match /shop-products/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
