{
  "rules": {
    ".read": false,
    ".write": false,
    "players": { ".read": "auth != null", ".write": "auth != null" },
    "emailSettings": { ".read": "auth != null", ".write": "auth != null" },
    "playerStars": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$playerId": { ".validate": "newData.val() == true || !newData.exists()" }
      }
    },
    "playerPhotos": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$playerId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 150000)" }
    },
    "teamPlans": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email == 'trials@flamingsix.co.uk' || root.child('coachProfiles').child(auth.uid).child('role').val() == 'admin')",
      "$team": {
        ".write": "auth != null && (auth.token.email == 'trials@flamingsix.co.uk' || root.child('coachProfiles').child(auth.uid).child('role').val() == 'admin' || root.child('coachProfiles').child(auth.uid).child('teams').child($team).val() == true)",
        ".validate": "newData.hasChildren(['Setter','Outside','Middle','Opposite','Libero','All-rounder']) && newData.child('Setter').isNumber() && newData.child('Outside').isNumber() && newData.child('Middle').isNumber() && newData.child('Opposite').isNumber() && newData.child('Libero').isNumber() && newData.child('All-rounder').isNumber() && newData.child('Setter').val() + newData.child('Outside').val() + newData.child('Middle').val() + newData.child('Opposite').val() + newData.child('Libero').val() + newData.child('All-rounder').val() >= 17"
      }
    },
    "coachProfiles": {
      ".read": "auth != null && (auth.token.email == 'trials@flamingsix.co.uk' || root.child('coachProfiles').child(auth.uid).child('role').val() == 'admin')",
      ".write": "auth != null && (auth.token.email == 'trials@flamingsix.co.uk' || root.child('coachProfiles').child(auth.uid).child('role').val() == 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'trials@flamingsix.co.uk' || root.child('coachProfiles').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (auth.token.email == 'trials@flamingsix.co.uk' || root.child('coachProfiles').child(auth.uid).child('role').val() == 'admin' || (auth.uid == $uid && !data.exists() && newData.child('role').val() == 'coach' && !newData.child('teams').exists()))",
        ".validate": "newData.hasChildren(['uid','email','displayName','role']) && newData.child('uid').val() == $uid && (newData.child('role').val() == 'coach' || newData.child('role').val() == 'admin')"
      }
    }
  }
}
